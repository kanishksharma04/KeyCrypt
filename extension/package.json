{
  "name": "@keycrypt/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KeyCrypt browser extension (Manifest V3): unlock locally and fill logins.",
  "license": "MIT",
  "scripts": {
    "build": "vite build && KEYCRYPT_BROWSER=firefox vite build",
    "typecheck": "tsc --noEmit",
    "build:chrome": "vite build",
    "build:firefox": "KEYCRYPT_BROWSER=firefox vite build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "keycrypt": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
