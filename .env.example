# ─────────────────────────────────────────────────────────────────────────────
# KeyCrypt — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Recommended on Vercel. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/prune-audit (daily, vercel.json), which deletes activity-log
# entries older than 180 days. At least 16 characters: openssl rand -base64 32
# Without it the route refuses every request; the app still prunes at most once a
# day on its own when events are logged.
# CRON_SECRET=""

# ── Operator contact ──────────────────────────────────────────────────────────
# Optional. Shown on /privacy and /terms as who runs this instance: an email
# address or an https:// URL. Without it the pages show a neutral placeholder.
# OPERATOR_CONTACT=""

# ── Two-factor sign-in (TOTP) ─────────────────────────────────────────────────
# Optional. 32 random bytes, base64: openssl rand -base64 32
# Encrypts users' TOTP secrets at rest. Without it, two-factor sign-in cannot be
# turned on, and accounts that already use it cannot pass the code step.
# Changing it locks those accounts out of 2FA codes (backup codes still work).
# TOTP_ENCRYPTION_KEY=""

# ── Client IP (rate limiting, audit log) ──────────────────────────────────────
# Optional. By default the client IP comes from x-vercel-forwarded-for, then
# x-real-ip, then the RIGHTMOST x-forwarded-for entry. Behind another proxy, set
# the single header it guarantees (e.g. cf-connecting-ip for Cloudflare). When
# set, ONLY that header is trusted; if it is missing the IP is "unknown".
# TRUSTED_IP_HEADER=""

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# Optional but recommended in production (especially serverless): shares rate-limit
# counts across instances. Set both or neither. Without them, an in-memory store
# is used and a warning is logged in production.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional. Email verification and password reset. Without SMTP, new accounts
# are verified automatically.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM=""
