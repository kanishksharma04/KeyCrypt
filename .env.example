# ─────────────────────────────────────────────────────────────────────────────
# KeyCrypt — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Client IP (rate limiting, audit log) ──────────────────────────────────────
# Optional. By default the client IP comes from x-vercel-forwarded-for, then
# x-real-ip, then the RIGHTMOST x-forwarded-for entry. Behind another proxy, set
# the single header it guarantees (e.g. cf-connecting-ip for Cloudflare). When
# set, ONLY that header is trusted; if it is missing the IP is "unknown".
# TRUSTED_IP_HEADER=""

# ── OAuth providers (added in Phase 2) ───────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── Email (added in Phase 2) ──────────────────────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM=""
