// KeyCrypt Prisma Schema (Prisma 6 / Auth.js v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 models (used by @auth/prisma-adapter) ────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Argon2id hash of the account (sign-in) password — never the master password.
  // Set at sign-up; a user without a hash cannot sign in with credentials.
  passwordHash  String?
  // Incremented to revoke every JWT session (sign out all devices, password
  // reset). Tokens carry the version they were issued with; see src/lib/session-version.ts.
  tokenVersion  Int       @default(0)
  // Two-factor sign-in (TOTP). Protects the ACCOUNT, not the vault:
  // totpSecretEnc is the TOTP secret encrypted on the server (AES-256-GCM,
  // TOTP_ENCRYPTION_KEY). Set but totpEnabledAt null = setup not yet confirmed.
  // totpBackupCodes holds Argon2id hashes of unused one-time backup codes.
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  totpBackupCodes String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  // WebAuthn passkey authenticators (scaffolded; no UI yet)
  authenticators Authenticator[]
  vaultMeta     VaultMeta?
  vaultItems    VaultItem[]
  auditLogs     AuditLog[]

  @@index([email])
}

// Linked OAuth accounts. Required by the Prisma adapter; stays empty because the
// only provider is Credentials.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Unused: the app uses JWT sessions (src/lib/auth.ts), so no rows are written
// here and deleting rows does not revoke a signed-in session. Kept for the adapter.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used for email verification and password reset tokens.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// WebAuthn passkey authenticators — scaffolded with no UI yet. Intended as a
// login factor only; it never touches the vault key.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ─── Vault models ─────────────────────────────────────────────────────────────

// Stores per-user key material. The server never has enough info here to
// decrypt the vault.
//
// cryptoVersion 1: vaultKey = PBKDF2(masterPassword, salt).
// cryptoVersion 2: vaultKey is random; it is stored wrapped (AES-GCM) under a
//   key-encryption key derived from the master password and `salt`. Changing
//   the master password only re-wraps it. v1 vaults upgrade on unlock.
model VaultMeta {
  id               String   @id @default(cuid())
  userId           String   @unique
  cryptoVersion    Int      @default(1)
  // Password KDF for `salt`: "pbkdf2" (v1 vault key) or "argon2id" (v2 KEK; all
  // new and upgraded vaults). kdfParams holds its cost parameters; null means the
  // historical PBKDF2-SHA-256 default of 600,000 iterations.
  kdf              String   @default("pbkdf2")
  kdfParams        Json?
  // Base64 random salt for the password-based key derivation
  salt             String
  // AES-256-GCM encrypted known-plaintext blob (under the vault key); used to
  // verify the key in the browser without comparing anything server-side.
  // Written at vault setup; a row without it is treated as "vault not set up".
  verificationBlob String?  @db.Text
  // IV for the verification blob encryption
  verificationIv   String?
  // v2: the vault key wrapped with AES-GCM under the key-encryption key (base64)
  wrappedVaultKey  String?  @db.Text
  // v2: IV for wrappedVaultKey (base64, 12 bytes)
  wrapIv           String?
  // v2 recovery kit: the SAME vault key wrapped under a key derived (HKDF) from
  // a random 128-bit recovery key the user keeps offline. Regenerating replaces it.
  recoveryWrappedKey String?   @db.Text
  recoveryIv         String?
  recoveryCreatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Item contents AND (crypto v2) the item name are opaque ciphertext.
// type, favorite and the timestamps are plain text and visible to the server.
model VaultItem {
  id         String        @id @default(cuid())
  userId     String
  type       VaultItemType
  // Plain-text item name, only for rows not yet moved to crypto v2. v2 items
  // store null here: the name lives inside the ciphertext, encrypted in the
  // browser ({ name, secret }), and is decrypted there for listing and search.
  name       String?
  // AES-256-GCM ciphertext (base64). Decrypted only in the browser.
  ciphertext String        @db.Text
  // Base64-encoded random 96-bit IV. Unique per encryption operation.
  iv         String
  favorite   Boolean       @default(false)
  // Not used yet; reserved for folder grouping
  folderId   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, favorite])
  @@index([userId, updatedAt])
}

enum VaultItemType {
  LOGIN
  SECURE_NOTE
  API_KEY
  WIFI_PASSWORD
  // Possible future types: SSH_KEY CRYPTO_WALLET OTP_SECRET BANK_DETAILS LICENSE
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. "auth.signin", "vault.item.create", "vault.item.delete"
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
