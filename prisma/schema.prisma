// KeyCrypt Prisma Schema (Prisma 6 / Auth.js v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js v5 models (used by @auth/prisma-adapter) ────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Argon2id hash of the account (sign-in) password — never the master password.
  // Set at sign-up; a user without a hash cannot sign in with credentials.
  passwordHash  String?
  // Incremented to revoke every JWT session (sign out all devices, password
  // reset). Tokens carry the version they were issued with; see src/lib/session-version.ts.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  // WebAuthn passkey authenticators (scaffolded; no UI yet)
  authenticators Authenticator[]
  vaultMeta     VaultMeta?
  vaultItems    VaultItem[]
  auditLogs     AuditLog[]

  @@index([email])
}

// Linked OAuth accounts. Required by the Prisma adapter; stays empty because the
// only provider is Credentials.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Unused: the app uses JWT sessions (src/lib/auth.ts), so no rows are written
// here and deleting rows does not revoke a signed-in session. Kept for the adapter.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used for email verification and password reset tokens.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// WebAuthn passkey authenticators — scaffolded with no UI yet. Intended as a
// login factor only; it never touches the vault key.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ─── Vault models ─────────────────────────────────────────────────────────────

// Stores per-user salt and encrypted verification blob.
// The server never has enough info here to decrypt the vault.
model VaultMeta {
  id               String   @id @default(cuid())
  userId           String   @unique
  // Base64-encoded random salt for PBKDF2-SHA-256 key derivation
  salt             String
  // AES-256-GCM encrypted known-plaintext blob; used to verify the master
  // password in the browser without comparing anything server-side. Written at
  // vault setup; a row without it is treated as "vault not set up".
  verificationBlob String?  @db.Text
  // IV for the verification blob encryption
  verificationIv   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Secret content (username, password, URL, notes, ...) is opaque ciphertext.
// name, type and favorite are plain text and visible to the server.
model VaultItem {
  id         String        @id @default(cuid())
  userId     String
  type       VaultItemType
  // Item name/label (e.g. "GitHub"). Stored in PLAIN TEXT and visible to the
  // server; used for listing and search. Never put secrets in it.
  name       String
  // AES-256-GCM ciphertext (base64). Decrypted only in the browser.
  ciphertext String        @db.Text
  // Base64-encoded random 96-bit IV. Unique per encryption operation.
  iv         String
  favorite   Boolean       @default(false)
  // Not used yet; reserved for folder grouping
  folderId   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, favorite])
  @@index([userId, updatedAt])
}

enum VaultItemType {
  LOGIN
  SECURE_NOTE
  API_KEY
  WIFI_PASSWORD
  // Possible future types: SSH_KEY CRYPTO_WALLET OTP_SECRET BANK_DETAILS LICENSE
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. "auth.signin", "vault.item.create", "vault.item.delete"
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
